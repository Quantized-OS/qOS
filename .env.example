# Optional dedicated RPC endpoint. Its genesis hash must still match the
# selected policy.json (Devnet by default; mainnet-beta for the qOS token).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Required in addition to an explicit command before any mainnet submission.
# QOS_ENABLE_MAINNET_BROADCAST=I_UNDERSTAND

# Required for the HTTP service, including loopback. Prefer a mode-0600 secret
# file. Mainnet service mode requires QOS_API_TOKEN_FILE and rejects an
# environment token. The built-in plaintext server refuses every non-loopback
# bind; terminate TLS in a separately isolated local proxy.
# QOS_API_TOKEN_FILE=/run/secrets/qos-api-token
# QOS_API_TOKEN=development-only-token-with-at-least-32-visible-ascii-bytes

# Preferred for agent workloads: an absolute-path adapter backed by an HSM,
# TPM, enclave, KMS, or separately isolated policy signer. qOS receives only
# the configured public key and a signing capability, never the private key.
# QOS_SIGNER_COMMAND=/absolute/path/to/reviewed-qos-signer-adapter
# QOS_SIGNER_ARGS_JSON=[]
# QOS_SIGNER_TIMEOUT_MS=10000

# Encrypted software-key fallback. The passphrase file must be mode 0600 and
# is read directly; do not put the passphrase itself in the environment.
# QOS_KEY_PASSPHRASE_FILE=/absolute/path/to/qos-passphrase

# Optional/required Groth16 or PLONK proof gate. The command must perform real
# proof verification with the exact verifying key whose SHA-256 is pinned here.
# QOS_REQUIRE_ZK_PROOF=1
# QOS_ZK_VERIFIER_COMMAND=/absolute/path/to/reviewed-zk-verifier-adapter
# QOS_ZK_VERIFIER_ARGS_JSON=[]
# QOS_ZK_PROOF_SYSTEM=groth16-bn254
# QOS_ZK_CIRCUIT_ID=qos-private-policy-v1
# QOS_ZK_VERIFYING_KEY_SHA256=replace-with-64-lowercase-hex-characters
# QOS_ZK_TIMEOUT_MS=15000

# QOS_HOME=.qos-ephemeral-devnet
# QOS_HOME=.qos-ephemeral-mainnet
# QOS_HOST=127.0.0.1
# QOS_PORT=8787

# Optional proposal model. Prefer a provider profile configured with qos model;
# its API key is stored in an owner-only file and never placed in this env file.
# QOS_AGENT_MODEL_PROFILE=openai-prod

# Legacy local-only OpenAI-compatible endpoint. No API key is sent on this path.
# QOS_AGENT_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# QOS_AGENT_MODEL=qwen2.5:3b
