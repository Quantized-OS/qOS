# Optional dedicated RPC endpoint. Its genesis hash must still match the
# selected policy.json (Devnet by default; mainnet-beta for the qOS token).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Required in addition to an explicit command before any mainnet submission.
# QOS_ENABLE_MAINNET_BROADCAST=I_UNDERSTAND

# Required when binding the HTTP service to a non-loopback address.
# QOS_API_TOKEN=replace-with-at-least-32-random-characters

# QOS_HOME=.qos-ephemeral-devnet
# QOS_HOME=.qos-ephemeral-mainnet
# QOS_HOST=127.0.0.1
# QOS_PORT=8787
