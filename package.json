{
  "name": "qos-solana-sandbox",
  "version": "0.7.2",
  "private": true,
  "description": "Policy signer for native SOL and the pinned qOS Token-2022 mint",
  "type": "module",
  "bin": {
    "qos": "./bin/qos.js",
    "qos-firmware-demo": "./bin/qos-firmware-demo.js"
  },
  "scripts": {
    "start": "node ./bin/qos.js serve",
    "demo": "bash ./run-demo.sh",
    "demo:build": "bash ./run-demo.sh --build-only",
    "test": "node --test",
    "check": "python3 ./tests/static_checks.py && node --check ./bin/qos.js && node --check ./bin/qos-firmware-demo.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BSD-2-Clause"
}
